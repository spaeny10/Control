generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  MEMBER
}

enum LeadType {
  NEW_COMPANY
  NEW_PROJECT
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  QUOTE_SENT
  WON
  LOST
}

enum ProjectStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum TrailerStatus {
  AVAILABLE
  DEPLOYED
  MAINTENANCE
  RETIRED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

// Billing cadence for products, quote lines, and subscriptions.
enum BillingCycle {
  ONE_TIME
  DAILY
  WEEKLY
  EVERY_28_DAYS
  MONTHLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  PAUSED
  ENDED
}

// PROJECT_COMPLETED is natural roll-off (expected in the rental business);
// the others count as true churn in KPIs.
enum SubscriptionEndReason {
  PROJECT_COMPLETED
  CUSTOMER_CANCELED
  LOST_TO_COMPETITOR
  NON_PAYMENT
  OTHER
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum MessageChannel {
  NOTE
  EMAIL
  SMS
  SYSTEM
}

enum MessageDirection {
  IN
  OUT
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// ---------- Auth ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MEMBER)
  isActive     Boolean  @default(true)
  // Commission as a percent of attributed active MRR per month (e.g. 5 = 5%).
  commissionRate Decimal @default(0) @db.Decimal(5, 2)
  salesTeamId  String?
  salesTeam    SalesTeam? @relation(fields: [salesTeamId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedLeads    Lead[]         @relation("LeadOwner")
  messages      Message[]
  dispatchJobs  DispatchJob[]  @relation("JobDriver")
  subscriptions Subscription[] @relation("SubscriptionSalesperson")
}

model SalesTeam {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  members User[]
}

// ---------- CRM ----------

model Company {
  id               String   @id @default(cuid())
  name             String
  billingStreet    String?
  billingCity      String?
  billingState     String?
  billingZip       String?
  website          String?
  notes            String?
  stripeCustomerId String?  @unique
  // Customer portal access link token — generated on first share.
  portalToken      String?  @unique
  // Branches: a branch is a company with a parent. One level deep —
  // quotes/contacts/prices stay per-branch, metrics roll up to the parent.
  parentCompanyId  String?
  parentCompany    Company? @relation("CompanyBranches", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  branches         Company[] @relation("CompanyBranches")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contacts      Contact[]
  leads         Lead[]
  projects      Project[]
  quotes        Quote[]
  subscriptions Subscription[]
  messages      Message[]
  priceOverrides CompanyPrice[]

  @@index([parentCompanyId])
}

// Branch/company-specific negotiated rate for a catalog product at a given
// billing cycle. Quote builder uses this over the catalog default.
model CompanyPrice {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planProductId String
  planProduct   PlanProduct  @relation(fields: [planProductId], references: [id], onDelete: Cascade)
  cycle         BillingCycle @default(MONTHLY)
  unitPrice     Decimal      @db.Decimal(12, 2)

  @@unique([companyId, planProductId, cycle])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  title     String?
  email     String?
  // E.164 format (+15551234567) so inbound SMS can be matched to the contact
  phone     String?
  notes     String?
  // Accounts-payable / billing contact for this company or branch —
  // preselected on quotes and used for invoice communications.
  isBillingContact Boolean @default(false)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads  Lead[]
  quotes Quote[]

  @@index([email])
  @@index([phone])
}

model Lead {
  id            String    @id @default(cuid())
  title         String
  type          LeadType
  stage         LeadStage @default(NEW)
  estValue      Decimal?  @db.Decimal(12, 2)
  source        String?
  expectedClose DateTime?
  lostReason    String?
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  quotes   Quote[]
  messages Message[]

  @@index([stage])
  @@index([companyId])
}

// The construction project / temporary job a rental serves.
// Companies accumulate projects over time (repeat-business KPIs).
model Project {
  id            String        @id @default(cuid())
  name          String
  status        ProjectStatus @default(UPCOMING)
  siteStreet    String?
  siteCity      String?
  siteState     String?
  siteZip       String?
  expectedStart DateTime?
  expectedEnd   DateTime?
  notes         String?
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  leads         Lead[]
  quotes        Quote[]
  subscriptions Subscription[]
  messages      Message[]

  @@index([companyId])
  @@index([status])
}

// ---------- Fleet ----------

model Trailer {
  id         String        @id @default(cuid())
  unitNumber String        @unique
  model      String?
  status     TrailerStatus @default(AVAILABLE)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  deployments     TrailerDeployment[]
  maintenanceLogs MaintenanceLog[]
  messages        Message[]
}

// Many trailers can be on one subscription/site at once.
// A trailer has at most one open deployment (returnedAt == null) at a time.
model TrailerDeployment {
  id             String       @id @default(cuid())
  trailerId      String
  trailer        Trailer      @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  deployedAt     DateTime     @default(now())
  returnedAt     DateTime?
  notes          String?

  // Condition documentation (photos + signature) at delivery and return.
  deliverySignedBy String?
  deliverySignedAt DateTime?
  returnSignedBy   String?
  returnSignedAt   DateTime?

  photos     DeploymentPhoto[]
  signatures DeploymentSignature[]

  @@index([trailerId])
  @@index([subscriptionId])
}

enum DeploymentPhase {
  DELIVERY
  RETURN
}

// Photos stored in Postgres — fine at this scale (client resizes to ~1600px
// JPEG before upload); revisit object storage if volume grows.
model DeploymentPhoto {
  id           String            @id @default(cuid())
  deploymentId String
  deployment   TrailerDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  phase        DeploymentPhase
  data         Bytes
  mimeType     String            @default("image/jpeg")
  caption      String?
  createdAt    DateTime          @default(now())

  @@index([deploymentId])
}

model DeploymentSignature {
  id           String            @id @default(cuid())
  deploymentId String
  deployment   TrailerDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  phase        DeploymentPhase
  data         Bytes // PNG from the signature canvas
  signedBy     String
  createdAt    DateTime          @default(now())

  @@index([deploymentId])
}

model MaintenanceLog {
  id          String   @id @default(cuid())
  trailerId   String
  trailer     Trailer  @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  description String
  cost        Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([trailerId])
}

// ---------- Quotes ----------

model Quote {
  id             String      @id @default(cuid())
  number         String      @unique // Q-2026-0001
  status         QuoteStatus @default(DRAFT)
  validUntil     DateTime?
  terms          String?
  publicToken    String      @unique @default(cuid())
  sentAt         DateTime?
  acceptedAt     DateTime?
  acceptedByName String?
  acceptedIp     String?
  declinedAt     DateTime?
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  lineItems     QuoteLineItem[]
  subscriptions Subscription[]
  messages      Message[]

  @@index([companyId])
  @@index([status])
}

model QuoteLineItem {
  id            String       @id @default(cuid())
  quoteId       String
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  cycle         BillingCycle
  description   String
  quantity      Int          @default(1)
  unitPrice     Decimal      @db.Decimal(12, 2)
  sortOrder     Int          @default(0)
  planProductId String?
  planProduct   PlanProduct? @relation(fields: [planProductId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

// Reusable catalog product. Prices live per billing cycle in ProductPrice —
// a trailer can have a daily, weekly, 28-day, and monthly rate at once.
model PlanProduct {
  id            String       @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean      @default(true)
  stripeProductId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  prices         ProductPrice[]
  quoteLineItems QuoteLineItem[]
  companyPrices  CompanyPrice[]
}

model ProductPrice {
  id            String       @id @default(cuid())
  planProductId String
  planProduct   PlanProduct  @relation(fields: [planProductId], references: [id], onDelete: Cascade)
  cycle         BillingCycle
  unitPrice     Decimal      @db.Decimal(12, 2)

  @@unique([planProductId, cycle])
}

// ---------- Billing ----------

model Subscription {
  id                   String                 @id @default(cuid())
  status               SubscriptionStatus     @default(PENDING)
  startDate            DateTime               @default(now())
  endedAt              DateTime?
  endReason            SubscriptionEndReason?
  endNotes             String?
  // Billing cadence and the amount charged per cycle. All recurring items on
  // one subscription share a cycle (Stripe constraint + operational sanity).
  billingCycle         BillingCycle           @default(MONTHLY)
  cycleAmount          Decimal                @default(0) @db.Decimal(12, 2)
  // Normalized monthly recurring value (cycleAmount x cycles-per-month) so
  // MRR, dashboards, and commissions stay comparable across cycles.
  mrr                  Decimal                @default(0) @db.Decimal(12, 2)
  stripeSubscriptionId String?                @unique
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quoteId              String?
  quote                Quote?                 @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  // Sales attribution: who won this business (from the lead owner at
  // conversion). Drives commission on active MRR.
  salespersonId        String?
  salesperson          User?                  @relation("SubscriptionSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  deployments  TrailerDeployment[]
  invoices     Invoice[]
  messages     Message[]
  dispatchJobs DispatchJob[]

  @@index([companyId])
  @@index([status])
}

// Mirror of Stripe invoices, synced via webhook.
model Invoice {
  id               String        @id @default(cuid())
  stripeInvoiceId  String        @unique
  number           String?
  status           InvoiceStatus @default(DRAFT)
  amountDue        Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0) @db.Decimal(12, 2)
  currency         String        @default("usd")
  hostedInvoiceUrl String?
  pdfUrl           String?
  dueDate          DateTime?
  paidAt           DateTime?
  periodStart      DateTime?
  periodEnd        DateTime?
  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([subscriptionId])
  @@index([status])
}

// ---------- Dispatch ----------

enum JobType {
  DELIVERY
  PICKUP
  SERVICE
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELED
}

// A dispatch job: deliver/pick up/service trailers on a date, assigned to a
// team member. Suggested automatically from new subscriptions and project
// end dates, or created by hand.
model DispatchJob {
  id             String    @id @default(cuid())
  type           JobType
  status         JobStatus @default(SCHEDULED)
  scheduledFor   DateTime
  notes          String?
  siteAddress    String?
  driverId       String?
  driver         User?     @relation("JobDriver", fields: [driverId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  trailerIds     String[] // unit ids involved (loose reference for flexibility)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([scheduledFor])
  @@index([status])
}

// ---------- Chatter ----------

// Polymorphic message: attached to exactly one parent record via nullable FKs.
model Message {
  id                String           @id @default(cuid())
  channel           MessageChannel
  direction         MessageDirection @default(OUT)
  subject           String?
  body              String
  fromAddress       String? // email address or phone number
  toAddress         String?
  providerMessageId String? // SendGrid/Twilio message id
  deliveryStatus    DeliveryStatus?
  authorId          String?
  author            User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quoteId        String?
  quote          Quote?        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trailerId      String?
  trailer        Trailer?      @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([quoteId])
  @@index([subscriptionId])
  @@index([companyId])
  @@index([trailerId])
  @@index([projectId])
  @@index([providerMessageId])
}
