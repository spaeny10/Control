generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  MEMBER
}

// The four functional areas of the app. MEMBERs see only their assigned
// areas; ADMINs implicitly have all of them.
enum AppArea {
  SALES
  FLEET
  ACCOUNTING
  TECH_ADMIN
}

enum LeadType {
  NEW_COMPANY
  NEW_PROJECT
}

// Shared by both lead tracks. UNQUALIFIED is the holding state excluded from
// every pipeline aggregate; QUOTE_SENT only applies to the project track
// (enforced in lead-actions.ts, since one column can't be two enums).
enum LeadStage {
  UNQUALIFIED
  CONTACTED
  QUALIFIED
  QUOTE_SENT
  WON
  LOST
}

enum ProjectStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum TrailerStatus {
  AVAILABLE
  DEPLOYED
  MAINTENANCE
  RETIRED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

// Billing cadence for products, quote lines, and subscriptions.
enum BillingCycle {
  ONE_TIME
  DAILY
  WEEKLY
  EVERY_28_DAYS
  MONTHLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  PAUSED
  ENDED
}

// PROJECT_COMPLETED is natural roll-off (expected in the rental business);
// the others count as true churn in KPIs.
enum SubscriptionEndReason {
  PROJECT_COMPLETED
  CUSTOMER_CANCELED
  LOST_TO_COMPETITOR
  NON_PAYMENT
  OTHER
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum MessageChannel {
  NOTE
  EMAIL
  SMS
  SYSTEM
}

enum MessageDirection {
  IN
  OUT
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// ---------- Auth ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // Nullable: users who sign in with Google have no local password.
  passwordHash String?
  role         Role     @default(MEMBER)
  isActive     Boolean  @default(true)
  areas        AppArea[] @default([SALES, FLEET, ACCOUNTING, TECH_ADMIN])
  // Commission as a percent of attributed active MRR per month (e.g. 5 = 5%).
  commissionRate Decimal @default(0) @db.Decimal(5, 2)
  salesTeamId  String?
  salesTeam    SalesTeam? @relation(fields: [salesTeamId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedLeads    Lead[]         @relation("LeadOwner")
  assignedActivities Activity[] @relation("ActivityAssignee")
  messages      Message[]
  dispatchJobs  DispatchJob[]  @relation("JobDriver")
  subscriptions Subscription[] @relation("SubscriptionSalesperson")
  recordedAcceptances Quote[]  @relation("QuoteAcceptanceRecorder")
}

model SalesTeam {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  members User[]
}

// ---------- CRM ----------

model Company {
  id               String   @id @default(cuid())
  name             String
  billingStreet    String?
  billingCity      String?
  billingState     String?
  billingZip       String?
  website          String?
  notes            String?
  stripeCustomerId String?  @unique
  // Customer portal access link token — generated on first share.
  portalToken      String?  @unique
  // Branches: a branch is a company with a parent. One level deep —
  // quotes/contacts/prices stay per-branch, metrics roll up to the parent.
  parentCompanyId  String?
  parentCompany    Company? @relation("CompanyBranches", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  branches         Company[] @relation("CompanyBranches")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contacts      Contact[]
  leads         Lead[]
  projects      Project[]
  quotes        Quote[]
  subscriptions Subscription[]
  messages      Message[]
  activities    Activity[]
  priceOverrides CompanyPrice[]

  @@index([parentCompanyId])
}

// Branch/company-specific negotiated rate for a catalog product at a given
// billing cycle. Quote builder uses this over the catalog default.
model CompanyPrice {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planProductId String
  planProduct   PlanProduct  @relation(fields: [planProductId], references: [id], onDelete: Cascade)
  cycle         BillingCycle @default(MONTHLY)
  unitPrice     Decimal      @db.Decimal(12, 2)

  @@unique([companyId, planProductId, cycle])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  title     String?
  email     String?
  // E.164 format (+15551234567) so inbound SMS can be matched to the contact
  phone     String?
  notes     String?
  // Accounts-payable / billing contact for this company or branch —
  // preselected on quotes and used for invoice communications.
  isBillingContact Boolean @default(false)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads  Lead[]
  quotes Quote[] @relation("QuoteSiteContact")
  // Quotes where this person is accounts payable rather than the site contact.
  billingQuotes Quote[] @relation("QuoteBillingContact")
  billingSubscriptions Subscription[] @relation("SubscriptionBillingContact")
  siteSubscriptions    Subscription[] @relation("SubscriptionSiteContact")

  @@index([email])
  @@index([phone])
}

// Two tracks, distinguished by `type`:
//   NEW_COMPANY — prospecting an organization onto the vendor/bid list. Carries
//     no MRR and never gets a quote; its win condition is "approved vendor".
//     Spawns NEW_PROJECT leads once real jobs surface.
//   NEW_PROJECT — a specific construction job. The only track that produces
//     deployable revenue, so it alone feeds pipeline MRR.
model Lead {
  id            String    @id @default(cuid())
  title         String
  type          LeadType
  stage         LeadStage @default(UNQUALIFIED)
  // Estimated monthly recurring revenue if won, the expected rental length,
  // and the resulting total contract value (mrr x months + one-times).
  // Project track only — always null on organization leads.
  estMrr        Decimal?  @db.Decimal(12, 2)
  estMonths     Int?
  estValue      Decimal?  @db.Decimal(12, 2)
  source        String?
  expectedClose DateTime?
  // Set when the lead reaches WON/LOST, cleared if it reopens. Win rate needs
  // a real close timestamp to be windowed — updatedAt moves on any edit.
  closedAt      DateTime?
  lostReason    String?
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // Which organization lead this project lead grew out of, so prospecting
  // effort stays attributable after the project is won.
  sourceLeadId  String?
  sourceLead    Lead?     @relation("LeadSpawn", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  quotes       Quote[]
  messages     Message[]
  activities   Activity[]
  spawnedLeads Lead[]     @relation("LeadSpawn")

  @@index([stage])
  @@index([companyId])
  @@index([sourceLeadId])
  // Every pipeline aggregate now filters on both.
  @@index([type, stage])
}

// The construction project / temporary job a rental serves.
// Companies accumulate projects over time (repeat-business KPIs).
model Project {
  id            String        @id @default(cuid())
  name          String
  status        ProjectStatus @default(UPCOMING)
  siteStreet    String?
  siteCity      String?
  siteState     String?
  siteZip       String?
  expectedStart DateTime?
  expectedEnd   DateTime?
  notes         String?
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  leads         Lead[]
  quotes        Quote[]
  subscriptions Subscription[]
  messages      Message[]
  activities    Activity[]

  @@index([companyId])
  @@index([status])
}

// ---------- Fleet ----------

model Trailer {
  id         String        @id @default(cuid())
  unitNumber String        @unique
  model      String?
  status     TrailerStatus @default(AVAILABLE)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  deployments     TrailerDeployment[]
  maintenanceLogs MaintenanceLog[]
  messages        Message[]
}

// Many trailers can be on one subscription/site at once.
// A trailer has at most one open deployment (returnedAt == null) at a time.
model TrailerDeployment {
  id             String       @id @default(cuid())
  trailerId      String
  trailer        Trailer      @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  deployedAt     DateTime     @default(now())
  returnedAt     DateTime?
  notes          String?

  // Condition documentation (photos + signature) at delivery and return.
  deliverySignedBy String?
  deliverySignedAt DateTime?
  returnSignedBy   String?
  returnSignedAt   DateTime?

  photos     DeploymentPhoto[]
  signatures DeploymentSignature[]

  @@index([trailerId])
  @@index([subscriptionId])
}

enum DeploymentPhase {
  DELIVERY
  RETURN
}

// Photos stored in Postgres — fine at this scale (client resizes to ~1600px
// JPEG before upload); revisit object storage if volume grows.
model DeploymentPhoto {
  id           String            @id @default(cuid())
  deploymentId String
  deployment   TrailerDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  phase        DeploymentPhase
  // Exactly one of data / driveFileId is set. Older rows keep their bytes;
  // new uploads go to Drive when it's configured. Serving routes dual-read.
  data         Bytes?
  driveFileId  String?
  mimeType     String            @default("image/jpeg")
  caption      String?
  createdAt    DateTime          @default(now())

  @@index([deploymentId])
}

model DeploymentSignature {
  id           String            @id @default(cuid())
  deploymentId String
  deployment   TrailerDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  phase        DeploymentPhase
  data         Bytes? // PNG from the signature canvas (or Drive, see below)
  driveFileId  String?
  signedBy     String
  createdAt    DateTime          @default(now())

  @@index([deploymentId])
}

model MaintenanceLog {
  id          String   @id @default(cuid())
  trailerId   String
  trailer     Trailer  @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  description String
  cost        Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([trailerId])
}

// ---------- Quotes ----------

// Construction customers accept by phone or a signed PDF as often as online,
// and conversion to a subscription requires an accepted quote — so the app has
// to be able to record those without pretending they were clicked.
enum QuoteAcceptanceMethod {
  ONLINE
  PHONE
  EMAIL
  SIGNED_DOCUMENT
  IN_PERSON
}

model Quote {
  id             String      @id @default(cuid())
  number         String      @unique // Q-2026-0001
  status         QuoteStatus @default(DRAFT)
  validUntil     DateTime?
  terms          String?
  publicToken    String      @unique @default(cuid())
  sentAt         DateTime?
  acceptedAt     DateTime?
  acceptedByName String?
  // Only set when the customer clicked Accept themselves.
  acceptedIp     String?
  // How the customer said yes. ONLINE means they used the public link; anything
  // else was recorded on their behalf by the user in acceptedByUser, so the
  // audit trail never implies a signature that didn't happen.
  acceptedVia    QuoteAcceptanceMethod?
  acceptedByUserId String?
  acceptedByUser   User?  @relation("QuoteAcceptanceRecorder", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  declinedAt     DateTime?
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /* Three distinct roles on a rental, because they're rarely the same person:
     contact       — the site/ops contact we coordinate delivery with (the PM)
     billingContact— accounts payable, who receives the invoice and cuts the check
     the delivery address lives on the linked Project, and is what sales tax is
     sourced from, since rental equipment is taxed where it sits. */
  contactId      String?
  contact        Contact?    @relation("QuoteSiteContact", fields: [contactId], references: [id], onDelete: SetNull)
  billingContactId String?
  billingContact Contact?    @relation("QuoteBillingContact", fields: [billingContactId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  lineItems     QuoteLineItem[]
  subscriptions Subscription[]
  messages      Message[]

  @@index([companyId])
  @@index([status])
}

model QuoteLineItem {
  id            String       @id @default(cuid())
  quoteId       String
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  cycle         BillingCycle
  description   String
  quantity      Int          @default(1)
  unitPrice     Decimal      @db.Decimal(12, 2)
  sortOrder     Int          @default(0)
  planProductId String?
  planProduct   PlanProduct? @relation(fields: [planProductId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

// Reusable catalog product. Prices live per billing cycle in ProductPrice —
// a trailer can have a daily, weekly, 28-day, and monthly rate at once.
model PlanProduct {
  id            String       @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean      @default(true)
  stripeProductId String?
  /* TaxCloud Taxability Information Code. Decides how this line is taxed at the
     jobsite — equipment rental, delivery, and setup labour are treated
     differently by state, and 0 is general tangible personal property. Null
     means nobody has classified it yet, which the catalog flags. */
  tic           Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  prices         ProductPrice[]
  quoteLineItems QuoteLineItem[]
  companyPrices  CompanyPrice[]
}

model ProductPrice {
  id            String       @id @default(cuid())
  planProductId String
  planProduct   PlanProduct  @relation(fields: [planProductId], references: [id], onDelete: Cascade)
  cycle         BillingCycle
  unitPrice     Decimal      @db.Decimal(12, 2)

  @@unique([planProductId, cycle])
}

// ---------- Billing ----------

model Subscription {
  id                   String                 @id @default(cuid())
  status               SubscriptionStatus     @default(PENDING)
  startDate            DateTime               @default(now())
  endedAt              DateTime?
  endReason            SubscriptionEndReason?
  endNotes             String?
  // Billing cadence and the amount charged per cycle. All recurring items on
  // one subscription share a cycle (Stripe constraint + operational sanity).
  billingCycle         BillingCycle           @default(MONTHLY)
  cycleAmount          Decimal                @default(0) @db.Decimal(12, 2)
  // Normalized monthly recurring value (cycleAmount x cycles-per-month) so
  // MRR, dashboards, and commissions stay comparable across cycles.
  mrr                  Decimal                @default(0) @db.Decimal(12, 2)
  stripeSubscriptionId String?                @unique
  companyId            String
  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quoteId              String?
  quote                Quote?                 @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  /* Copied from the quote at conversion, then editable — over a long rental the
     AP clerk changes, and the quote is a signed document we shouldn't rewrite.
     The invoice email goes to billingContact; the driver calls siteContact. */
  /* Card payment is opt-in per subscription: most customers remit by check, and
     card is only offered when the signed terms say so. When it isn't offered,
     Stripe's hosted invoice is restricted so a card can't be used at all —
     otherwise Stripe would happily take one and we'd eat the processing cost.
     The fee is a percent of the invoice, captured per subscription so a
     negotiated rate sticks with the deal. */
  cardPaymentAllowed   Boolean                @default(false)
  convenienceFeePct    Decimal?               @db.Decimal(5, 2)
  billingContactId     String?
  billingContact       Contact?               @relation("SubscriptionBillingContact", fields: [billingContactId], references: [id], onDelete: SetNull)
  siteContactId        String?
  siteContact          Contact?               @relation("SubscriptionSiteContact", fields: [siteContactId], references: [id], onDelete: SetNull)
  // Sales attribution: who won this business (from the lead owner at
  // conversion). Drives commission on active MRR.
  salespersonId        String?
  salesperson          User?                  @relation("SubscriptionSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  deployments  TrailerDeployment[]
  invoices     Invoice[]
  messages     Message[]
  dispatchJobs DispatchJob[]
  activities   Activity[]

  @@index([companyId])
  @@index([status])
}

// Mirror of Stripe invoices, synced via webhook.
model Invoice {
  id               String        @id @default(cuid())
  stripeInvoiceId  String        @unique
  number           String?
  status           InvoiceStatus @default(DRAFT)
  amountDue        Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0) @db.Decimal(12, 2)
  currency         String        @default("usd")
  hostedInvoiceUrl String?
  pdfUrl           String?
  dueDate          DateTime?
  paidAt           DateTime?
  periodStart      DateTime?
  periodEnd        DateTime?
  /* Sales tax, calculated by TaxCloud from the jobsite address before the
     invoice finalizes. cartId is the calculation, orderId is the reported
     transaction, and taxReportedAt is when it entered a filing — set on payment
     because we file cash-basis. taxNeedsReview flags a zero result on a line
     that should have been taxed, since TaxCloud answers zero both for
     genuinely-exempt items and for states we aren't registered in. */
  taxAmount        Decimal?      @db.Decimal(12, 2)
  taxCloudCartId   String?
  taxCloudOrderId  String?
  taxReportedAt    DateTime?
  taxNeedsReview   Boolean       @default(false)
  /* The convenience fee is only charged when a card was actually used, so it
     can't be known until this invoice is paid. paidByCard records what we
     found; convenienceFeeAmount records the fee we then queued onto the
     customer's next invoice, and doubles as the idempotency key so a replayed
     webhook can't bill it twice. */
  paidByCard       Boolean       @default(false)
  convenienceFeeAmount Decimal?  @db.Decimal(12, 2)
  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([subscriptionId])
  @@index([status])
}

// ---------- Dispatch ----------

enum JobType {
  DELIVERY
  PICKUP
  SERVICE
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELED
}

// A dispatch job: deliver/pick up/service trailers on a date, assigned to a
// team member. Suggested automatically from new subscriptions and project
// end dates, or created by hand.
model DispatchJob {
  id             String    @id @default(cuid())
  type           JobType
  status         JobStatus @default(SCHEDULED)
  scheduledFor   DateTime
  notes          String?
  siteAddress    String?
  driverId       String?
  driver         User?     @relation("JobDriver", fields: [driverId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  trailerIds     String[] // unit ids involved (loose reference for flexibility)
  // Google Calendar event id (one-way sync, app is source of truth).
  googleEventId  String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([scheduledFor])
  @@index([status])
}

// ---------- Planned activities ----------

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  SITE_VISIT
}

// Future-facing planning: what should happen next on a record (chatter logs
// what already happened). Completing one writes a chatter entry.
model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  title       String
  notes       String?
  dueDate     DateTime
  done        Boolean      @default(false)
  completedAt DateTime?
  // Google Calendar event id (one-way sync, app is source of truth).
  googleEventId String?
  assigneeId  String?
  assignee    User?        @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // matched by User.assignedActivities
  createdAt   DateTime     @default(now())

  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([assigneeId, done, dueDate])
  @@index([leadId])
  @@index([companyId])
  @@index([projectId])
  @@index([subscriptionId])
}

// ---------- Chatter ----------

// Polymorphic message: attached to exactly one parent record via nullable FKs.
model Message {
  id                String           @id @default(cuid())
  channel           MessageChannel
  direction         MessageDirection @default(OUT)
  subject           String?
  body              String
  fromAddress       String? // email address or phone number
  toAddress         String?
  // @unique makes this a real idempotency key: Pub/Sub delivers at-least-once,
  // so two concurrent deliveries must not both insert. NULL is unconstrained,
  // so NOTE/SYSTEM messages are unaffected.
  providerMessageId String? @unique
  // Gmail thread id — inbound replies are matched to a record by thread.
  providerThreadId  String?
  deliveryStatus    DeliveryStatus?
  authorId          String?
  author            User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quoteId        String?
  quote          Quote?        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trailerId      String?
  trailer        Trailer?      @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([quoteId])
  @@index([subscriptionId])
  @@index([companyId])
  @@index([trailerId])
  @@index([projectId])
  @@index([providerThreadId])
}

// One row per Gmail mailbox we watch, so push notifications can be resolved
// incrementally (Gmail push carries only a historyId) and the ~7-day watch
// can be renewed before it lapses.
model GmailSyncState {
  id           String  @id @default(cuid())
  emailAddress String  @unique
  // Doubles as the impersonation allowlist: we refuse to act on any mailbox
  // that isn't an active row here.
  isActive     Boolean @default(true)

  lastHistoryId   String? // uint64 as string; only ever advanced forwards
  watchExpiration DateTime?
  // Concurrency claim. Pub/Sub can deliver two notifications at once; a
  // claim column is pool-safe, unlike pg advisory locks under Prisma pooling.
  syncLockedAt    DateTime?
  lastSyncedAt    DateTime?
  lastError       String?
  updatedAt       DateTime  @updatedAt

  @@index([watchExpiration])
}
