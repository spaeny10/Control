# Copy to .env and fill in values.

DATABASE_URL="postgresql://user:password@host:5432/railway"

AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+1..."

# ---- Google Workspace ----
# Email/Calendar/Drive run through a service account with domain-wide
# delegation, so there are no per-user OAuth tokens to store.
# Base64-encode the whole service-account JSON into one line to avoid the
# classic mangled-newline problem in env vars:
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY=""
GOOGLE_WORKSPACE_PRIMARY_DOMAIN="jetstreamsys.com"
GOOGLE_SEND_AS_DOMAIN="bigview.ai"
# Mailbox that owns Drive uploads and shared-calendar events.
GOOGLE_DRIVE_OWNER="admin@jetstreamsys.com"
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
# Optional: calendar for dispatch jobs with no assigned driver.
GOOGLE_SHARED_CALENDAR_ID=""

# Sign in with Google (separate OAuth client — identity only, no API scopes).
# Redirect URI to register: https://app.bigview.ai/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Pin the OAuth redirect host in production (include the /api/auth path).
AUTH_URL="https://app.bigview.ai/api/auth"

# Gmail push notifications. The push subscription must authenticate with an
# OIDC token whose audience equals the endpoint URL below.
GOOGLE_PUBSUB_TOPIC="projects/<project>/topics/gmail-inbound"
GOOGLE_PUBSUB_PUSH_AUDIENCE="https://app.bigview.ai/api/webhooks/google/gmail"
GOOGLE_PUBSUB_PUSH_SA="pubsub-pusher@<project>.iam.gserviceaccount.com"

# Domain-wide delegation scopes to grant in Google Admin console (exact match):
#   https://www.googleapis.com/auth/calendar.events,
#   https://www.googleapis.com/auth/gmail.send,
#   https://www.googleapis.com/auth/gmail.readonly,
#   https://www.googleapis.com/auth/gmail.settings.basic,
#   https://www.googleapis.com/auth/drive.file

# SendGrid is superseded by Gmail — kept only for reference.
# SENDGRID_API_KEY=""

# ---- Sales tax (TaxCloud v3) ----
# Both credentials come from TaxCloud > Integrations > your connection.
# The origin is our own nexus address; TaxCloud needs both ends of the
# transaction, and the destination is always the jobsite, because rental
# equipment is taxed where it sits.
# Unset = no tax is calculated and billing proceeds untaxed.
TAXCLOUD_API_KEY=""
TAXCLOUD_CONNECTION_ID=""
TAXCLOUD_ORIGIN_STREET=""
TAXCLOUD_ORIGIN_CITY=""
TAXCLOUD_ORIGIN_STATE=""
TAXCLOUD_ORIGIN_ZIP=""
